<?xml version="1.0"?>
<job_config>
  <input>
    <video>
      <mov_sidecar version="1">
        <track_id>-1</track_id>    <!-- integer -->
        <mov_file_name>MOV_FILE_NAME</mov_file_name>    <!-- string -->
        <md_file_name>MD_FILE_NAME</md_file_name>    <!-- string -->
        <storage>
          <local_multi_path>
            <path>PATH</path>    <!-- string -->
          </local_multi_path>
        </storage>
      </mov_sidecar>
    </video>
  </input>
  <filter>
    <video>
      <dv_mezz_to_dv_profile_7_bl version="1">
        <use_case>no_mapping_with_fel</use_case>    <!-- One of: no_mapping_with_mel, no_mapping_with_fel, map_to_1000_nits_with_fel, map_to_1000_nits_with_mel, map_to_600_nits_with_fel -->
        <start>0</start>    <!-- string -->
        <end>0</end>    <!-- string -->
        <metadata_offset>0</metadata_offset>    <!-- integer -->
        <active_area_offset_top>-1</active_area_offset_top>    <!-- integer -->
        <active_area_offset_bottom>-1</active_area_offset_bottom>    <!-- integer -->
        <active_area_offset_left>-1</active_area_offset_left>    <!-- integer -->
        <active_area_offset_right>-1</active_area_offset_right>    <!-- integer -->
        <signal_range_coded>auto</signal_range_coded>    <!-- One of: auto, computer, video, signal -->
        <content_mapping>auto</content_mapping>    <!-- One of: auto, none, 600, 1000 -->
        <decoder_parallel_frames>0</decoder_parallel_frames>    <!-- integer: from 0 to 16 -->
        <target_width>3840</target_width>    <!-- integer -->
        <target_height>2160</target_height>    <!-- integer -->
        <decoder>
          <prores_dec>
            <apple_dlb/>
          </prores_dec>
        </decoder>
        <scaling>
          <base>
            <source_crop_top>0</source_crop_top>    <!-- integer -->
            <source_crop_bottom>0</source_crop_bottom>    <!-- integer -->
            <source_crop_left>0</source_crop_left>    <!-- integer -->
            <source_crop_right>0</source_crop_right>    <!-- integer -->
          </base>
        </scaling>
        <noise>
          <base>
            <strength>0</strength>    <!-- fixed value -->
          </base>
        </noise>
      </dv_mezz_to_dv_profile_7_bl>
    </video>
  </filter>
  <output>
    <yuv420p10le version="1">
      <file_name>FILE_NAME</file_name>    <!-- string -->
      <storage>
        <local_multi_path>
          <path>PATH</path>    <!-- string -->
        </local_multi_path>
      </storage>
    </yuv420p10le>
    <manifest version="1">
      <file_name>FILE_NAME</file_name>    <!-- string -->
      <storage>
        <local_multi_path>
          <path>PATH</path>    <!-- string -->
        </local_multi_path>
      </storage>
    </manifest>
  </output>
  <misc>
    <temp_dir>
      <clean_temp>true</clean_temp>
      <path>PATH</path>
    </temp_dir>
  </misc>
</job_config>
